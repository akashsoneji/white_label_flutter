# Per-flavor Android release signing template.
#
# For each flavor that needs its OWN keystore, create a folder and two files:
#   android/keystore/<flavor>/<flavor>.jks         (the keystore — gitignored)
#   android/keystore/<flavor>/<flavor>.properties  (these values — gitignored)
#
# Example for the "pipze" flavor -> android/keystore/pipze/pipze.properties:
#
#   storeFile=keystore/pipze/pipze.jks
#   storePassword=your_store_password
#   keyAlias=pipze
#   keyPassword=your_key_password
#
# Notes:
# - storeFile is resolved relative to the android/ directory (rootProject).
# - Generate a keystore with:
#     keytool -genkey -v -keystore android/keystore/pipze/pipze.jks \
#             -keyalg RSA -keysize 2048 -validity 10000 -alias pipze
# - build.gradle.kts auto-detects keystore/<flavor>/<flavor>.properties and
#   signs that flavor with it. Flavors without a file fall back to the global
#   release key (android/keystore.properties) or the debug key.
# - Never commit real .jks or .properties files — they are gitignored.

storeFile=keystore/<flavor>/<flavor>.jks
storePassword=
keyAlias=<flavor>
keyPassword=
