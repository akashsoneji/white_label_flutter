<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen behavior.
         We force a plain-color splash (no app icon) so the first frame is just background color,
         then Flutter's own SplashScreen shows the SVG logo. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/my_splash_color</item>
        <item name="windowSplashScreenAnimatedIcon">@null</item>
        <item name="windowSplashScreenIconBackgroundColor">@null</item>
        <!-- Keep compatibility with older embedding which reads windowBackground -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

