      { "name": "IB transfer history", "request": { "method": "GET", "url": "{{base_url}}user/ib/transfer/history" } },
      { "name": "IB transfer store", "request": { "method": "POST", "url": "{{base_url}}user/ib/transfer/store" } },
      { "name": "IBM client system gate", "request": { "method": "GET", "url": "{{base_url}}ibm/client/system" } },
      { "name": "IBM client account groups", "request": { "method": "GET", "url": "{{base_url}}ibm/client/account-groups" } },
      { "name": "IBM client partner request", "request": { "method": "POST", "url": "{{base_url}}ibm/client/partner-request" } },
      { "name": "IBM client partner request status", "request": { "method": "GET", "url": "{{base_url}}ibm/client/partner-request" } },
      { "name": "IBM dashboard", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/dashboard" } },
      { "name": "IBM dashboard activity", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/dashboard/activity" } },
      { "name": "IBM network", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/network" } },
      { "name": "IBM network summary", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/network/summary" } },
      { "name": "IBM network tree summary", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/network/tree-summary" } },
      { "name": "IBM network performance", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/network/performance" } },
      { "name": "IBM partner detail", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/network/{{id}}" } },
      { "name": "IBM partner node", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/network/{{id}}/node" } },
      { "name": "IBM partner wallet", "request": { "method": "GET", "url": "{{base_url}}ibm/portal/network/{{id}}/wallet" } },
      { "name": "IBM wallet withdrawal", "request": { "method": "POST", "url": "{{base_url}}ibm/portal/wallet/withdraw" } }
    ] },
    { "name": "10 Copy Trading", "description": "Screens: Hub, masters, trader details, investments, subscriptions, master dashboard/plans/copiers. Local: mock trader detail, plan/subscription state, PnL aggregation, pagination and form validation.", "item": [
