      { "name": "Trade Win claim", "request": { "method": "POST", "url": "{{base_url}}v1/user/trade-win/claim" } }
    ] },
    { "name": "12 Support Tickets", "description": "Screens: ticket list/create/detail/reply/close/attachments. Local: pagination, refresh-after-mutation, upload state, confirmation and toasts.", "item": [
