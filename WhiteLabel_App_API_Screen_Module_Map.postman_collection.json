      { "name": "Master status", "request": { "method": "GET", "url": "{{base_url}}user/copytrading/master/status" } },
      { "name": "Master dashboard overview", "request": { "method": "GET", "url": "{{base_url}}user/copytrading/master/dashboard-overview" } },
      { "name": "Master plans", "request": { "method": "GET", "url": "{{base_url}}user/copytrading/master/plans" } },
